# EMQX - listeners, password auth (built-in database bootstrapped from users.csv)
# and SCRAM-SHA-256 enhanced auth (its user is created by emqx-setup.sh)
EMQX_NODE__NAME=emqx@127.0.0.1
EMQX_NODE__COOKIE=mqtt-get-interop
EMQX_DASHBOARD__LISTENERS__HTTP__BIND=0.0.0.0:21081
EMQX_LISTENERS__TCP__DEFAULT__BIND=0.0.0.0:21883
EMQX_LISTENERS__WS__DEFAULT__BIND=0.0.0.0:21083
EMQX_LISTENERS__SSL__DEFAULT__BIND=0.0.0.0:21893
EMQX_LISTENERS__SSL__DEFAULT__SSL_OPTIONS__CERTFILE=/certs/server.crt
EMQX_LISTENERS__SSL__DEFAULT__SSL_OPTIONS__KEYFILE=/certs/server.key
EMQX_LISTENERS__SSL__DEFAULT__SSL_OPTIONS__CACERTFILE=/certs/ca.crt
EMQX_LISTENERS__SSL__DEFAULT__SSL_OPTIONS__VERIFY=verify_none
EMQX_LISTENERS__SSL__MTLS__BIND=0.0.0.0:21894
EMQX_LISTENERS__SSL__MTLS__SSL_OPTIONS__CERTFILE=/certs/server.crt
EMQX_LISTENERS__SSL__MTLS__SSL_OPTIONS__KEYFILE=/certs/server.key
EMQX_LISTENERS__SSL__MTLS__SSL_OPTIONS__CACERTFILE=/certs/ca.crt
EMQX_LISTENERS__SSL__MTLS__SSL_OPTIONS__VERIFY=verify_peer
EMQX_LISTENERS__SSL__MTLS__SSL_OPTIONS__FAIL_IF_NO_PEER_CERT=true
EMQX_LISTENERS__WSS__DEFAULT__BIND=0.0.0.0:21094
EMQX_LISTENERS__WSS__DEFAULT__SSL_OPTIONS__CERTFILE=/certs/server.crt
EMQX_LISTENERS__WSS__DEFAULT__SSL_OPTIONS__KEYFILE=/certs/server.key
EMQX_LISTENERS__WSS__DEFAULT__SSL_OPTIONS__CACERTFILE=/certs/ca.crt
EMQX_AUTHENTICATION=[{mechanism = password_based, backend = built_in_database, user_id_type = username, password_hash_algorithm {name = plain, salt_position = disable}, bootstrap_file = "/certs/users.csv", bootstrap_type = plain}, {mechanism = scram, backend = built_in_database, algorithm = sha256, iteration_count = 4096}]
